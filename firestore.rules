rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper validation
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // OPS Profiles
    match /ops_profiles/{opsId} {
      allow read: if true;
      allow write: if isValidId(opsId);
    }

    // Pelanggan (Warga)
    match /pelanggan/{pelangganId} {
      allow read: if true;
      allow write: if isValidId(pelangganId);
    }

    // Pembayaran Iuran
    match /pembayaran/{pembayaranId} {
      allow read: if true;
      allow write: if isValidId(pembayaranId);
    }

    // Transaksi Pengangkutan Sampah & Clean-up
    match /pengangkutan/{pengangkutanId} {
      allow read: if true;
      allow write: if isValidId(pengangkutanId);
    }

    // Transaksi Kas (Arus Kas)
    match /transaksi_kas/{kasId} {
      allow read: if true;
      allow write: if isValidId(kasId);
    }

    // Komposisi Sampah
    match /komposisi/{opsId} {
      allow read: if true;
      allow write: if isValidId(opsId);
    }

    // Admin Accounts for each OPS
    match /admin_accounts/{adminId} {
      allow read: if true;
      allow write: if isValidId(adminId);
    }

    // Kunci Bulan Kas (Tutup Buku)
    match /kunci_bulan_kas/{lockId} {
      allow read: if true;
      allow create, update: if isValidId(lockId)
        && request.resource.data.id == lockId
        && request.resource.data.opsId is string
        && request.resource.data.tahun is int
        && request.resource.data.bulan is int
        && request.resource.data.bulan >= 1
        && request.resource.data.bulan <= 12;
      allow delete: if isValidId(lockId);
    }

    // Log Aktivitas Sistem
    match /log_aktivitas/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId)
        && request.resource.data.keys().hasAll([
          'id', 'timestamp', 'tanggal', 'actorId', 'actorName', 'actorRole', 'opsId', 'opsNama', 'modul', 'aksi', 'deskripsi'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'timestamp', 'tanggal', 'actorId', 'actorName', 'actorRole', 'opsId', 'opsNama', 'modul', 'aksi', 'deskripsi', 'targetId', 'detail'
        ])
        && request.resource.data.id == logId
        && request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 64
        && request.resource.data.tanggal is string && request.resource.data.tanggal.size() <= 20
        && request.resource.data.actorId is string && request.resource.data.actorId.size() <= 128
        && request.resource.data.actorName is string && request.resource.data.actorName.size() <= 128
        && request.resource.data.actorRole is string && request.resource.data.actorRole.size() <= 32
        && request.resource.data.opsId is string && request.resource.data.opsId.size() <= 128
        && request.resource.data.opsNama is string && request.resource.data.opsNama.size() <= 160
        && request.resource.data.modul is string && request.resource.data.modul.size() <= 64
        && request.resource.data.aksi is string && request.resource.data.aksi.size() <= 32
        && request.resource.data.deskripsi is string && request.resource.data.deskripsi.size() <= 500
        && (!('targetId' in request.resource.data) || (request.resource.data.targetId is string && request.resource.data.targetId.size() <= 160))
        && (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() <= 1000));
      allow delete: if isValidId(logId);
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
