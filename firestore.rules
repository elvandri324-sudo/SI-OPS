rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper validation
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // OPS Profiles
    match /ops_profiles/{opsId} {
      allow read: if true;
      allow write: if isValidId(opsId);
    }

    // Pelanggan (Warga)
    match /pelanggan/{pelangganId} {
      allow read: if true;
      allow write: if isValidId(pelangganId);
    }

    // Pembayaran Iuran
    match /pembayaran/{pembayaranId} {
      allow read: if true;
      allow write: if isValidId(pembayaranId);
    }

    // Transaksi Pengangkutan Sampah & Clean-up
    match /pengangkutan/{pengangkutanId} {
      allow read: if true;
      allow write: if isValidId(pengangkutanId);
    }

    // Transaksi Kas (Arus Kas)
    match /transaksi_kas/{kasId} {
      allow read: if true;
      allow write: if isValidId(kasId);
    }

    // Komposisi Sampah
    match /komposisi/{opsId} {
      allow read: if true;
      allow write: if isValidId(opsId);
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
